{
  "name": "coagent",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:integration",
    "runtime:pin": "tsx scripts/pin-runtime.ts",
    "runtime:probe": "tsx scripts/probe-runtime.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron dist/desktop/main.mjs",
    "test:agent": "tsx scripts/regression-live.ts",
    "test:desktop": "node scripts/desktop-e2e.mjs",
    "test:desktop:approval": "tsx scripts/desktop-approval-e2e.ts",
    "test:desktop:workbench": "node scripts/desktop-workbench.mjs",
    "test:desktop:host": "tsx scripts/desktop-host-crash.ts",
    "test:desktop:settings": "node scripts/desktop-settings.mjs",
    "test:desktop:settings:live": "node scripts/desktop-settings-live.mjs",
    "test:desktop:providers": "tsx scripts/desktop-providers.ts",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs",
    "test:desktop:package": "node scripts/test-package.mjs",
    "test:desktop:startup": "node scripts/desktop-startup.mjs",
    "test:desktop:diagnostics": "tsx scripts/desktop-diagnostics.ts",
    "diagnose:chat:live": "tsx scripts/chat-diagnostics-live.ts",
    "smoke:chat:live": "tsx scripts/live-smoke.ts --chat --resume",
    "test:agent:chat": "tsx scripts/regression-live.ts --chat",
    "test:desktop:plugins": "node scripts/desktop-plugins.mjs",
    "test:desktop:mcp": "tsx scripts/desktop-mcp.ts",
    "test:browser:mcp": "tsx scripts/mcp-browser-probe.ts",
    "test:browser:service": "electron scripts/browser-service-test.mjs",
    "test:desktop:browser": "tsx scripts/desktop-browser.ts",
    "test:browser:compatibility": "electron scripts/browser-compatibility.mjs",
    "test:desktop:resources": "node scripts/desktop-resource-grants.mjs",
    "test:desktop:command-scopes": "tsx scripts/desktop-command-scopes.ts",
    "test:desktop:projects": "tsx scripts/desktop-projects.ts",
    "test:desktop:security": "node scripts/desktop-security.mjs",
    "test:desktop:command-risk": "tsx scripts/desktop-command-risk.ts"
  },
  "dependencies": {
    "@openai/codex": "0.155.1",
    "@playwright/mcp": "0.0.82",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
